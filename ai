#!/usr/bin/env bash
set -euo pipefail

# Usage: ai [prompt...]

pwd=$(pwd -P)

# keep in sync with mrai.settings.workspace_key
sha256() { if command -v sha256sum &>/dev/null; then sha256sum; else shasum -a 256; fi; }
name=$(basename "$pwd" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
name=$(printf '%s' "${name:0:40}" | sed -E 's/-+$//')
key="${name:-root}-$(printf '%s' "$pwd" | sha256 | cut -c1-8)"

mrai_home="${MRAI_HOME:-$HOME/.mrai}"
data_dir="$mrai_home/workspaces/$key"
# outside data_dir: the container can write there
hist_file="$mrai_home/history/$key"

remember() {
    local line tmp
    line=$(printf '%s' "${1//$'\n'/↩}" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
    [[ -z "$line" ]] && return 0
    (
        umask 077
        mkdir -p "$(dirname "$hist_file")"
        touch "$hist_file"
        tmp="$hist_file.$$"
        { grep -vxF -- "$line" "$hist_file" || true; printf '%s\n' "$line"; } | tail -n 1000 >"$tmp"
        mv "$tmp" "$hist_file"
    )
}

# Terminal rows a "> <text>" input line took, so they can be erased and redrawn.
input_rows() {
    local cols
    cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
    [[ "$cols" =~ ^[1-9][0-9]*$ ]] || cols=80
    echo $(((2 + ${#1} + cols - 1) / cols))
}

# Redraw the prompt in green: it's accepted, and the container is starting.
show_submitted() {
    [[ -t 2 && -n "${1//[[:space:]]/}" ]] || return 0
    local l
    while IFS= read -r l; do printf '\e[32m> %s\e[0m\n' "$l" >&2; done <<<"$1"
}

compose() {
    local line text= rows=0 rc send prompt="> " key=$'\037'
    unset HISTFILE
    history -c
    [[ -f "$hist_file" ]] && history -r "$hist_file"
    local hint="What do you need to know about this codebase?  (Enter twice or Ctrl-J: send · ↑/↓ history · Ctrl-R search)"
    if command -v gum &>/dev/null; then gum style --foreground 240 "$hint" >&2; else echo "$hint" >&2; fi
    # `bind` is ignored outside interactive shells, so keys go in via INPUTRC. Ctrl-J,
    # Alt-Enter and CSI-u Shift-Enter insert a literal \037 and accept: "send now".
    rc=$(mktemp)
    printf '%s\n' '$include ~/.inputrc' 'set input-meta on' 'set output-meta on' 'set convert-meta off' \
        '"\C-j": "\C-v\037\C-m"' '"\e\r": "\C-v\037\C-m"' '"\e[13;2u": "\C-v\037\C-m"' >"$rc"
    while INPUTRC=$rc IFS= read -e -r -p "$prompt" line; do
        send=
        [[ "$line" == *"$key"* ]] && send=1 line=${line//$key/}
        rows=$((rows + $(input_rows "$line")))
        [[ -z "$line" && -z "$send" ]] && break
        text+=${text:+$'\n'}$line
        prompt="  "
        [[ -n "$send" ]] && break
    done
    rm -f "$rc"
    [[ -t 2 && $rows -gt 0 ]] && printf '\e[%dA\e[J' "$rows" >&2
    text=${text//↩/$'\n'}
    show_submitted "$text"
    printf '%s' "$text"
}

# Update reminder: daily background tag lookup; MRAI_NO_UPDATE_CHECK=1 disables.
image="${MRAI_IMAGE:-ghcr.io/madhuravius/mrai}"
repo="${MRAI_REPO:-https://github.com/madhuravius/mrai}"
update_cache="$mrai_home/update-check"
# set by `ai --update`: the verified image digest to run
pin_file="$mrai_home/pinned-image"
run_image=$image
[[ -f "$pin_file" ]] && run_image=$(<"$pin_file")

newest_tag() {
    awk -F'[v.]' '/^v[0-9]+\.[0-9]+\.[0-9]+$/ {
        k = sprintf("%09d%09d%09d", $2, $3, $4); if (k > m) { m = k; t = $0 }
    } END { if (t) print t }'
}

version_lt() {
    local a b i
    IFS=. read -r -a a <<<"${1#v}"
    IFS=. read -r -a b <<<"${2#v}"
    for i in 0 1 2; do
        ((10#${a[i]:-0} < 10#${b[i]:-0})) && return 0
        ((10#${a[i]:-0} > 10#${b[i]:-0})) && return 1
    done
    return 1
}

latest_tag() {
    GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs "$repo" 2>/dev/null |
        sed -n 's|.*refs/tags/||p' | newest_tag
}

refresh_update_cache() {
    local now last
    now=$(date +%s)
    last=$(cut -d' ' -f1 "$update_cache" 2>/dev/null || echo 0)
    ((now - ${last:-0} < 86400)) && return 0
    last=$(cat "$update_cache.attempt" 2>/dev/null || echo 0)
    ((now - ${last:-0} < 3600)) && return 0
    mkdir -p "$mrai_home"
    printf '%s\n' "$now" >"$update_cache.attempt"
    (
        latest=$(latest_tag)
        [[ -n "$latest" ]] || exit 0
        printf '%s %s\n' "$(date +%s)" "$latest" >"$update_cache.$$"
        mv "$update_cache.$$" "$update_cache"
    ) </dev/null &>/dev/null &
    disown 2>/dev/null || true
}

warn_if_outdated() {
    [[ -z "${MRAI_NO_UPDATE_CHECK:-}" && -t 2 ]] || return 0
    command -v git &>/dev/null && refresh_update_cache
    local latest installed msg
    latest=$(cut -d' ' -f2 "$update_cache" 2>/dev/null) || return 0
    installed=$(docker image inspect "$run_image" \
        --format '{{ index .Config.Labels "org.opencontainers.image.version" }}' 2>/dev/null)
    installed="${installed%%-*}"
    [[ "$installed" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ && -n "$latest" ]] || return 0
    version_lt "$installed" "$latest" || return 0
    msg="⚠ mrai $latest is available (you have $installed). Update: "
    if [[ -f "$pin_file" ]]; then msg+="ai --update"; else msg+="git pull && make install"; fi
    if command -v gum &>/dev/null; then
        gum style --foreground 214 "$msg" >&2
    else
        printf '\e[33m%s\e[0m\n' "$msg" >&2
    fi
}

die() { printf '\e[31m%s\e[0m\n' "$*" >&2; exit 1; }

update() {
    command -v cosign &>/dev/null ||
        die "ai --update needs cosign to verify the image: https://docs.sigstore.dev/cosign/system_config/installation/"
    local tag ref
    tag=$(latest_tag)
    [[ -n "$tag" ]] || die "no release found at $repo"
    docker pull "$image:$tag" || die "pull failed: $image:$tag"
    ref=$(docker image inspect "$image:$tag" --format '{{range .RepoDigests}}{{println .}}{{end}}' |
        grep -m1 "^$image@sha256:") || die "no registry digest for $image:$tag"
    cosign verify "$ref" \
        --certificate-identity-regexp "^${repo//./\\.}/\\.github/workflows/release\\.yml@refs/tags/v" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null ||
        die "signature check failed for $ref; keeping the current image"
    mkdir -p "$mrai_home"
    printf '%s\n' "$ref" >"$pin_file"
    printf '%s %s\n' "$(date +%s)" "$tag" >"$update_cache"
    echo "mrai $tag verified and installed ($ref)"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: ai [prompt...]   (no prompt: compose one interactively)

Wrapper options:
  --update   pull the newest release, verify it with cosign, and pin it

Everything else goes to mrai in the container:

EOF
fi

if [[ "${1:-}" == "--update" ]]; then
    update
    exit 0
fi

if [[ -f "$pin_file" ]] && ! docker image inspect "$run_image" &>/dev/null; then
    die "pinned image $run_image is missing; run: ai --update"
fi

warn_if_outdated

if [[ $# -gt 0 ]]; then
    prompt="$*"
else
    prompt="$(compose)"
fi

prompt=$(printf '%s\n' "${prompt}" | sed -n '/[^[:space:]]/p')
[[ -z "${prompt}" ]] && exit 0
[[ "$prompt" == "-h" || "$prompt" == "--help" ]] || remember "$prompt"

# docker would create a missing bind source as root
mkdir -p "$data_dir" "$mrai_home/site"

# All workspaces read-only (the cross-workspace search index reads every topic log;
# the agent's own tools stay confined to the repo), this workspace and the shared
# HTML site writable. Paths mirror the host layout under /tmp/mrai-home.
ws_root=/tmp/mrai-home/workspaces
mounts=(
    -v "$mrai_home/workspaces:$ws_root:ro"
    -v "$data_dir:$ws_root/$key"
    -v "$mrai_home/site:/tmp/mrai-home/site"
    -v "$pwd:$pwd:ro"
)
# Shared config is optional; only mount it if it is a real file (a missing
# source would otherwise be created by docker as a root-owned directory).
if [[ -f "$mrai_home/mrai.yml" ]]; then
    mounts+=(-v "$mrai_home/mrai.yml:/tmp/mrai-home/mrai.yml:ro")
fi

run_flags=(--rm -i)
[[ -t 0 && -t 1 ]] && run_flags+=(-t)
# CI probes the sandbox with this (tests/container/probe.sh)
[[ -n "${MRAI_ENTRYPOINT:-}" ]] && run_flags+=(--entrypoint "$MRAI_ENTRYPOINT")

docker run "${run_flags[@]}" \
	--user "$(id -u):$(id -g)" \
	--tmpfs /tmp \
	--tmpfs /home/nonroot/.cache \
	--cap-drop ALL \
	--security-opt=no-new-privileges \
	"${mounts[@]}" \
	-w "$pwd" \
	-e MRAI_API_KEY \
	-e MRAI_OPENROUTER_API_KEY \
	-e OPENROUTER_API_KEY \
	-e OPENAI_API_KEY \
	-e ANTHROPIC_API_KEY \
	-e MRAI_PROFILE \
	-e MRAI_DIR="$ws_root/$key" \
	-e MRAI_HOST_DIR="$data_dir" \
	-e MRAI_HOST_HOME="$mrai_home" \
	-e MRAI_HOME=/tmp/mrai-home \
	-e COLUMNS \
	-e TERM \
	-e COLORTERM \
	"$run_image" "$prompt"
